{
  "name": "code-class-live-sharing",
  "displayName": "Code Class Live Sharing",
  "description": "Real-time classroom sharing for code files and Jupyter notebooks — students follow .ipynb, .py, .md in their browser, with drawing, polls, and chat",
  "version": "2.5.4",
  "publisher": "codeclasslive",
  "license": "MIT",
  "keywords": [
    "classroom",
    "teaching",
    "education",
    "live sharing",
    "real-time",
    "broadcast",
    "jupyter",
    "notebook",
    "ipynb",
    "collaboration",
    "drawing",
    "poll",
    "preview"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/paircodingofficial-cloud/code-class-live-sharing"
  },
  "bugs": {
    "url": "https://github.com/paircodingofficial-cloud/code-class-live-sharing/issues",
    "email": "seolmuah@gmail.com"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Education",
    "Notebooks"
  ],
  "activationEvents": [
    "onNotebook:jupyter-notebook",
    "onCommand:codeClassLive.startSession",
    "onCommand:codeClassLive.openViewer",
    "onCommand:codeClassLive.openTeacherPreview",
    "onWebviewPanel:codeClassLive.teacherPreview"
  ],
  "icon": "resources/icon.png",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Starting a sharing session runs a local server and the cloudflared tunnel executable, so workspace trust is required."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Sharing reads files from the local disk and is not available in virtual workspaces."
    }
  },
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codeClassLive.startSession",
        "title": "Start Session",
        "category": "Code Class Live Sharing"
      },
      {
        "command": "codeClassLive.stopSession",
        "title": "Stop Session",
        "category": "Code Class Live Sharing"
      },
      {
        "command": "codeClassLive.openViewer",
        "title": "Open Viewer",
        "category": "Code Class Live Sharing"
      },
      {
        "command": "codeClassLive.createPoll",
        "title": "Create Poll",
        "category": "Code Class Live Sharing"
      },
      {
        "command": "codeClassLive.endPoll",
        "title": "End Poll",
        "category": "Code Class Live Sharing"
      },
      {
        "command": "codeClassLive.openTeacherPreview",
        "title": "Open Teacher Preview",
        "category": "Code Class Live Sharing"
      },
      {
        "command": "codeClassLive.shareTerminal",
        "title": "Share This Terminal with Students",
        "category": "Code Class Live Sharing"
      },
      {
        "command": "codeClassLive.stopShareTerminal",
        "title": "Stop Sharing Terminal",
        "category": "Code Class Live Sharing"
      }
    ],
    "menus": {
      "terminal/title/context": [
        {
          "command": "codeClassLive.shareTerminal",
          "when": "!codeClassLive.terminalSharing",
          "group": "codeClassLive@1"
        },
        {
          "command": "codeClassLive.stopShareTerminal",
          "when": "codeClassLive.terminalSharing",
          "group": "codeClassLive@1"
        }
      ],
      "terminal/context": [
        {
          "command": "codeClassLive.shareTerminal",
          "when": "!codeClassLive.terminalSharing",
          "group": "codeClassLive@1"
        },
        {
          "command": "codeClassLive.stopShareTerminal",
          "when": "codeClassLive.terminalSharing",
          "group": "codeClassLive@1"
        }
      ]
    },
    "configuration": {
      "title": "Code Class Live Sharing",
      "properties": {
        "codeClassLive.port": {
          "type": "number",
          "default": 48632,
          "description": "Local server port for the live share session"
        },
        "codeClassLive.maxViewers": {
          "type": "number",
          "default": 100,
          "description": "Maximum number of concurrent viewers"
        },
        "codeClassLive.tunnelProvider": {
          "type": "string",
          "enum": [
            "cloudflare",
            "none"
          ],
          "default": "cloudflare",
          "description": "Tunnel provider for external access"
        },
        "codeClassLive.bindAddress": {
          "type": "string",
          "enum": [
            "127.0.0.1",
            "0.0.0.0"
          ],
          "default": "127.0.0.1",
          "description": "Network interface the local server binds to. Keep the default (127.0.0.1) unless you need direct LAN access without the tunnel — 0.0.0.0 exposes the session to everyone on your local network."
        },
        "codeClassLive.imageMaxSizeKB": {
          "type": "number",
          "default": 2048,
          "description": "Maximum image size in KB that can be shared (default: 2048). Larger images are not sent; shrink them first."
        },
        "codeClassLive.shareExplorer": {
          "type": "boolean",
          "default": true,
          "description": "Share the workspace file tree (names only) with students in the viewer sidebar"
        },
        "codeClassLive.terminal.maskSecrets": {
          "type": "boolean",
          "default": true,
          "description": "Mask secret-looking strings (API keys, tokens, private key blocks) in shared terminal output. Requires VS Code 1.93 or later. Masking is a mistake-prevention aid, not a security guarantee."
        },
        "codeClassLive.terminal.maxOutputKB": {
          "type": "number",
          "default": 64,
          "minimum": 1,
          "maximum": 256,
          "description": "Maximum output size (KB) shared per terminal command. Output beyond this limit is truncated. Requires VS Code 1.93 or later."
        },
        "codeClassLive.terminal.maxCommands": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "maximum": 500,
          "description": "Number of recent terminal commands kept for students who join late. Requires VS Code 1.93 or later."
        },
        "codeClassLive.terminal.blockedCommandPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "^env$",
            "^printenv\\b",
            "^export\\b",
            "^set$",
            "^history\\b",
            "^(cat|head|tail|less|more|bat|type)\\b.*(token|\\.env|\\.pem|credential|secret|password|id_rsa|\\.npmrc|\\.aws)",
            "^sed\\b.*(token|\\.env|\\.pem|credential)",
            "^aws\\s+configure\\b",
            "^git\\s+remote\\s+-v\\b",
            "^gh\\s+auth\\s+token\\b",
            "^security\\s+find-generic-password\\b"
          ],
          "description": "Regular expressions (case-insensitive) for commands whose output is never shared. Requires VS Code 1.93 or later. This block list is a mistake-prevention aid, not a security guarantee."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeClassLive",
          "title": "Code Class Live Sharing",
          "icon": "resources/icon.svg"
        }
      ],
      "panel": [
        {
          "id": "codeClassLiveChat",
          "title": "Viewer Chat",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "codeClassLive": [
        {
          "id": "codeClassLive.sessionView",
          "name": "Session",
          "type": "webview"
        }
      ],
      "codeClassLiveChat": [
        {
          "id": "codeClassLive.viewerChatPanel",
          "name": "Chat",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "compile": "webpack --mode development",
    "watch": "webpack --mode development --watch",
    "build": "webpack --mode production",
    "vscode:prepublish": "npm run build",
    "lint": "eslint src --ext ts",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/sharp": "^0.31.1",
    "@types/vscode": "^1.82.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "copy-webpack-plugin": "^12.0.0",
    "css-loader": "^6.10.0",
    "eslint": "^8.56.0",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "express": "^4.22.2",
    "ws": "^8.21.0"
  }
}
